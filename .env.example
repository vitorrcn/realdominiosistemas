# Copie este arquivo para ".env" e preencha com valores reais antes de rodar
# o projeto. Nunca commite o ".env" de verdade.

# String de conexão do PostgreSQL.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/real_dominio?schema=public"

# Segredo usado pelo NextAuth para assinar sessões/JWT E também para derivar
# a chave de criptografia dos acessos a sistemas (src/lib/crypto.ts) — troque
# por um valor aleatório longo e mantenha em segredo. Gere um com:
#   openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-um-valor-aleatorio-longo"

# URL pública onde o sistema está rodando (usada pelo NextAuth em redirects).
NEXTAUTH_URL="http://localhost:41295"

# Segredo opcional para permitir chamar POST /api/obrigacoes/gerar
# (geração mensal das obrigações) via cron externo, sem sessão de usuário.
CRON_SECRET="troque-por-um-valor-aleatorio"
