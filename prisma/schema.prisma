generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Importante: usar aqui a conexão DIRETA (sem pooling/PgBouncer) do
  // banco. A URL com pooling que a integração Neon/Vercel expõe por
  // padrão não suporta o advisory lock que o `prisma migrate` precisa
  // adquirir (erro P1002), e o campo `directUrl` do Prisma para separar
  // as duas conexões tem um bug nesta versão (5.10.0) que quebra o
  // `prisma generate`. Para o volume de uso deste sistema, a conexão
  // direta atende bem tanto migração quanto runtime.
  url      = env("DATABASE_URL")
}

enum PerfilGlobal {
  DIRETORIA
  LIDER
  OPERADOR
  CONSULTA
}

model Usuario {
  id                String       @id @default(uuid())
  nome              String
  email             String       @unique
  senhaHash         String
  perfilGlobal      PerfilGlobal @default(OPERADOR)
  ativo             Boolean      @default(true)
  podeVerComercial  Boolean      @default(false)
  // Acesso a Relacoes Comerciais entre clientes (fora Diretoria, que sempre tem acesso)
  podeVerRelacoesComerciais Boolean @default(false)
  // Bloco de notas pessoal - rascunho livre, so o proprio usuario ve.
  notaPessoal       String?      @db.Text
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?
  setores           UsuarioSetor[]
  auditoria         Auditoria[]
  notificacoes      Notificacao[]
  obrigacoesResp    ObrigacaoInstancia[]
  tarefasResp       Tarefa[]
  eventosResp       Evento[]
  eventosCriados    Evento[]     @relation("EventoCriador")
  empresasFiscal    Empresa[]    @relation("RespFiscal")
  empresasContabil  Empresa[]    @relation("RespContabil")
  empresasDp        Empresa[]    @relation("RespDp")
  empresasSociet    Empresa[]    @relation("RespSocietario")
  empresasCarteira  Empresa[]    @relation("RespCarteira")
  empresasLider     Empresa[]    @relation("RespLider")
  registrosAtividade RegistroAtividade[]
  agendaItens       AgendaItem[] @relation("AgendaUsuario")
  agendaCriados     AgendaItem[] @relation("AgendaCriador")
  lembretes         Lembrete[]
  acessosCriados    AcessoSistema[]
  eventoHistoricos  EventoHistorico[]
  relacoesComerciaisCriadas RelacaoComercial[]
  alteracoesContratuaisCriadas AlteracaoContratual[]
  @@map("usuarios")
}

model Setor {
  id          String   @id @default(uuid())
  nome        String   @unique
  descricao   String?
  ativo       Boolean  @default(true)
  ordem       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  usuarios           UsuarioSetor[]
  obrigacaoTemplates ObrigacaoTemplate[]
  tarefas            Tarefa[]
  eventos            Evento[]
  tiposEvento        TipoEvento[]
  agendaItens        AgendaItem[]
  acessos            AcessoSistema[]
  @@map("setores")
}

model UsuarioSetor {
  id         String   @id @default(uuid())
  usuarioId  String
  setorId    String
  // "membro" (padrão) ou "supervisor". Supervisor enxerga e edita a
  // carteira INTEIRA desse setor (todas as empresas, não só as próprias),
  // mas continua sem acesso aos outros setores. Cada setor comporta até
  // 2 supervisores (validado na API de usuários).
  papel      String   @default("membro")
  createdAt  DateTime @default(now())
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
  setor      Setor    @relation(fields: [setorId], references: [id])
  @@unique([usuarioId, setorId])
  @@map("usuario_setores")
}

enum StatusEmpresa {
  CADASTRO_INCOMPLETO
  IMPLANTACAO
  ATIVA
  EM_ATENCAO
  INATIVA
  ENCERRADA
  EX_CLIENTE
}

enum RegimeTributario {
  MEI
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
  CARNE_LEAO
  ISENTO
  OUTRO
}

enum TipoPessoa {
  PJ
  PF
}

// Natureza/porte societario da empresa (MEI, ME, EPP etc.) - informado na
// aba Societario do cadastro.
enum TipoSocietario {
  MEI
  ME
  EI
  EPP
  EIRELI
  SA
  LTDA
}

model Empresa {
  id              String        @id @default(uuid())
  codigoInterno   String        @unique
  tipoPessoa      TipoPessoa    @default(PJ)
  cnpj            String?       @unique
  cpf             String?       @unique
  razaoSocial     String
  nomeFantasia    String?
  municipio       String?
  bairro          String?
  estado          String?
  endereco        String?
  numero          String?
  complemento     String?
  cep             String?
  telefone        String?
  email           String?
  inscricaoMunicipal String?
  inscricaoEstadual  String?
  capitalSocial   Decimal?      @db.Decimal(14, 2)
  cnae            String?
  dataAbertura    DateTime?
  status          StatusEmpresa @default(CADASTRO_INCOMPLETO)
  dataEntrada     DateTime?
  dataSaida       DateTime?
  empresaBaixada  Boolean       @default(false)
  obsCritica      String?
  obsAtual        String?
  ativo           Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  respFiscalId    String?
  respContabilId  String?
  respDpId        String?
  respSocietId    String?
  respCarteiraId  String?
  respLiderId     String?
  respFiscal      Usuario?      @relation("RespFiscal",     fields: [respFiscalId],   references: [id])
  respContabil    Usuario?      @relation("RespContabil",   fields: [respContabilId], references: [id])
  respDp          Usuario?      @relation("RespDp",         fields: [respDpId],       references: [id])
  respSocietario  Usuario?      @relation("RespSocietario", fields: [respSocietId],   references: [id])
  // Responsável pela carteira (operador que atende o cliente no dia a dia)
  respCarteira    Usuario?      @relation("RespCarteira",   fields: [respCarteiraId], references: [id])
  respLider       Usuario?      @relation("RespLider",      fields: [respLiderId],    references: [id])
  fiscal          Fiscal?
  contabil        Contabil?
  dp              Dp?
  societario      Societario?
  relacionamento  Relacionamento?
  comercial       Comercial?
  socios          EmpresaPessoa[]
  eventos         Evento[]
  tarefas         Tarefa[]
  obrigacoes      ObrigacaoEmpresa[]
  documentos      Documento[]
  obsHistorico    ObsHistorico[]
  acessos         AcessoSistema[]
  registrosAtividade RegistroAtividade[]
  relacoesPrestador  RelacaoComercial[] @relation("RelacaoPrestador")
  relacoesTomador    RelacaoComercial[] @relation("RelacaoTomador")
  alteracoesContratuais AlteracaoContratual[]
  @@map("empresas")
}

model Pessoa {
  id             String    @id @default(uuid())
  nome           String
  cpf            String    @unique
  dataNascimento DateTime?
  estadoCivil    String?
  telefone       String?
  email          String?
  ativo          Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  conjugeId      String?
  conjuge        Pessoa?   @relation("Conjuge", fields: [conjugeId], references: [id])
  conjugeDe      Pessoa[]  @relation("Conjuge")
  dependentes    PessoaDependente[] @relation("Responsavel")
  dependenteDe   PessoaDependente[] @relation("Dependente")
  empresas       EmpresaPessoa[]
  irpf           Irpf[]
  documentos     Documento[]
  @@map("pessoas")
}

model EmpresaPessoa {
  id                     String   @id @default(uuid())
  empresaId              String
  pessoaId               String
  percentualParticipacao Decimal? @db.Decimal(5, 2)
  eAdministrador         Boolean  @default(false)
  dataInicio             DateTime?
  dataFim                DateTime?
  createdAt              DateTime @default(now())
  empresa Empresa @relation(fields: [empresaId], references: [id])
  pessoa  Pessoa  @relation(fields: [pessoaId],  references: [id])
  @@unique([empresaId, pessoaId])
  @@map("empresa_pessoas")
}

model PessoaDependente {
  id            String  @id @default(uuid())
  responsavelId String
  dependenteId  String
  parentesco    String?
  responsavel Pessoa @relation("Responsavel", fields: [responsavelId], references: [id])
  dependente  Pessoa @relation("Dependente",  fields: [dependenteId],  references: [id])
  @@unique([responsavelId, dependenteId])
  @@map("pessoa_dependentes")
}

model Fiscal {
  id                   String            @id @default(uuid())
  empresaId            String            @unique
  regimeTributario     RegimeTributario?
  inicioRegime         DateTime?
  ultimaRevisao        DateTime?
  proximaRevisao       DateTime?
  inscricaoEstadual    String?
  inscricaoMunicipal   String?
  acessoEstado         String?
  acessoPrefeitura     String?
  parcelamentoAtivo    Boolean           @default(false)
  qtdParcelamentos     Int               @default(0)
  orgaoParcelamento    String?
  situacaoParcelamento String?
  possuiDebitos        Boolean           @default(false)
  prefEnvioGuia        String?
  diaPrefEnvio         Int?
  observacoes          String?
  updatedAt            DateTime          @updatedAt
  empresa Empresa @relation(fields: [empresaId], references: [id])
  @@map("fiscal")
}

model Contabil {
  id                  String    @id @default(uuid())
  empresaId           String    @unique
  ultimoFechamento    DateTime?
  obsExtratos         String?
  possuiEmprestimo    Boolean   @default(false)
  possuiFinanciamento Boolean   @default(false)
  ultimoResultado     String?
  competenciaResult   String?
  confiabilidade      String?
  situacaoImovel      String?   // "PROPRIO" | "ALUGADO"
  ramoId              String?
  updatedAt           DateTime  @updatedAt
  empresa Empresa      @relation(fields: [empresaId], references: [id])
  ramo    RamoEmpresa? @relation(fields: [ramoId], references: [id])
  contasBancarias ContaBancaria[]
  @@map("contabil")
}

// Registro de cada conta bancaria do cliente - qual banco, ate onde ja
// temos o extrato conferido, e se a conta ainda esta ativa.
model ContaBancaria {
  id           String    @id @default(uuid())
  contabilId   String
  banco        String
  agencia      String?
  numeroConta  String?
  ativa        Boolean   @default(true)
  extratoAte   DateTime?
  observacoes  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  contabil     Contabil  @relation(fields: [contabilId], references: [id])
  @@map("contas_bancarias")
}

model RamoEmpresa {
  id        String     @id @default(uuid())
  nome      String     @unique
  ativo     Boolean    @default(true)
  ordem     Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  empresas  Contabil[]
  relacoesComerciais RelacaoComercial[]
  @@map("ramos_empresa")
}

// Relacao comercial entre dois clientes do escritorio (ex.: cliente X
// prestou um servico para o cliente Y). Area restrita: so Diretoria e
// quem tiver Usuario.podeVerRelacoesComerciais alimentam e consultam.
model RelacaoComercial {
  id          String    @id @default(uuid())
  prestadorId String    // empresa que prestou o servico/produto
  tomadorId   String    // empresa que tomou o servico/produto
  ramoId      String?   // categoria da atividade prestada (reaproveita Ramos)
  descricao   String?
  valor       Decimal?  @db.Decimal(14, 2)
  data        DateTime?
  observacoes String?
  criadoPorId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  prestador   Empresa      @relation("RelacaoPrestador", fields: [prestadorId], references: [id])
  tomador     Empresa      @relation("RelacaoTomador",   fields: [tomadorId],   references: [id])
  ramo        RamoEmpresa? @relation(fields: [ramoId], references: [id])
  criadoPor   Usuario      @relation(fields: [criadoPorId], references: [id])
  @@map("relacoes_comerciais")
}

model Dp {
  id                 String   @id @default(uuid())
  empresaId          String   @unique
  possuiFuncionarios Boolean  @default(false)
  qtdFuncionarios    Int      @default(0)
  possuiProlabore    Boolean  @default(false)
  qtdSociosfolha     Int      @default(0)
  possuiInssPatronal Boolean  @default(false)
  possuiPisFolha     Boolean  @default(false)
  rat                Decimal? @db.Decimal(5, 2)
  fap                Decimal? @db.Decimal(5, 4)
  terceiros          Boolean  @default(false)
  observacoes        String?
  updatedAt          DateTime @updatedAt
  empresa Empresa @relation(fields: [empresaId], references: [id])
  @@map("dp")
}

model Societario {
  id                    String    @id @default(uuid())
  empresaId             String    @unique
  tipoSocietario        TipoSocietario?
  contratoAtualizado    Boolean   @default(false)
  ultimaAlteracaoContr  DateTime?
  certificadoDigital    Boolean   @default(false)
  tipoCertificado       String?
  situacaoCertificado   String?
  vencimentoCertificado DateTime?
  procuracaoRF          Boolean   @default(false)
  procuracaoEstado      Boolean   @default(false)
  procuracaoMunicipio   Boolean   @default(false)
  acessoRF              String?
  acessoEstado          String?
  acessoMunicipio       String?
  licencas              String?
  alvaras               String?
  observacoes           String?
  updatedAt             DateTime  @updatedAt
  empresa Empresa @relation(fields: [empresaId], references: [id])
  @@map("societario")
}

model Relacionamento {
  id                 String    @id @default(uuid())
  empresaId          String    @unique
  ultimoContato      DateTime?
  ultimaReuniao      DateTime?
  ultimaVisita       DateTime?
  formaPrefContato   String?
  tempoResposta      String?
  perfilCliente      String?
  // Pessoa(s) a quem pedir documentos/extratos do cliente - antes era um
  // campo simples dentro de Contabil ("pessoa para solicitar extratos"),
  // movido pra cá com telefone e e-mail de contato direto.
  pessoaDocumentos   String?
  telefoneDocumentos String?
  emailDocumentos    String?
  observacoes        String?
  updatedAt          DateTime  @updatedAt
  empresa Empresa @relation(fields: [empresaId], references: [id])
  @@map("relacionamento")
}

model Comercial {
  id                String    @id @default(uuid())
  empresaId         String    @unique
  origem            String?
  quemIndicou       String?
  motivoContratacao String?
  honorarios        Decimal?  @db.Decimal(10, 2)
  contrato          String?
  dataEntrada       DateTime?
  motivoSaida       String?
  descricaoSaida    String?
  updatedAt         DateTime  @updatedAt
  empresa Empresa @relation(fields: [empresaId], references: [id])
  @@map("comercial")
}

model Irpf {
  id                 String   @id @default(uuid())
  pessoaId           String
  ano                Int
  declaracaoEntregue Boolean  @default(false)
  imoveis            String?
  participacoes      String?
  investimentos      String?
  patrimonio         String?
  contasBancarias    String?
  observacoes        String?
  updatedAt          DateTime @updatedAt
  pessoa Pessoa @relation(fields: [pessoaId], references: [id])
  @@unique([pessoaId, ano])
  @@map("irpf")
}

enum StatusEvento {
  NAO_INICIADO
  EM_ANDAMENTO
  AGUARDANDO_CLIENTE
  AGUARDANDO_ORGAO
  AGUARDANDO_SETOR
  CONCLUIDO
  CANCELADO
}

model TipoEvento {
  id      String  @id @default(uuid())
  nome    String
  setorId String?
  ativo   Boolean @default(true)
  setor   Setor?  @relation(fields: [setorId], references: [id])
  eventos Evento[]
  @@map("tipos_evento")
}

model Evento {
  id           String       @id @default(uuid())
  empresaId    String
  tipoEventoId String?
  respGeralId  String?
  setorAtualId String?
  respAtualId  String?
  criadoPorId  String?
  dataAbertura DateTime     @default(now())
  prazo        DateTime?
  status       StatusEvento @default(NAO_INICIADO)
  observacoes  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?
  empresa    Empresa     @relation(fields: [empresaId],    references: [id])
  tipoEvento TipoEvento? @relation(fields: [tipoEventoId], references: [id])
  setorAtual Setor?      @relation(fields: [setorAtualId], references: [id])
  respAtual  Usuario?    @relation(fields: [respAtualId],  references: [id])
  criadoPor  Usuario?    @relation("EventoCriador", fields: [criadoPorId], references: [id])
  historico  EventoHistorico[]
  tarefas    Tarefa[]
  @@map("eventos")
}

model EventoHistorico {
  id             String   @id @default(uuid())
  eventoId       String
  usuarioId      String?
  dataHora       DateTime @default(now())
  descricao      String
  statusAnterior String?
  statusNovo     String?
  evento  Evento   @relation(fields: [eventoId], references: [id])
  usuario Usuario? @relation(fields: [usuarioId], references: [id])
  @@map("evento_historico")
}

enum StatusTarefa {
  NAO_INICIADO
  EM_ANDAMENTO
  AGUARDANDO_CLIENTE
  AGUARDANDO_ORGAO
  AGUARDANDO_SETOR
  CONCLUIDO
  CANCELADO
}

model Tarefa {
  id            String       @id @default(uuid())
  empresaId     String
  eventoId      String?
  setorId       String?
  responsavelId String?
  titulo        String
  descricao     String?
  dataInicio    DateTime?
  prazo         DateTime?
  dataConclusao DateTime?
  status        StatusTarefa @default(NAO_INICIADO)
  motivoAtraso  String?
  observacoes   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?
  empresa     Empresa  @relation(fields: [empresaId],     references: [id])
  evento      Evento?  @relation(fields: [eventoId],      references: [id])
  setor       Setor?   @relation(fields: [setorId],       references: [id])
  responsavel Usuario? @relation(fields: [responsavelId], references: [id])
  @@map("tarefas")
}

enum StatusObrigacao {
  NAO_INICIADO
  EM_ANDAMENTO
  AGUARDANDO_CLIENTE
  RECEBIDO_PARCIALMENTE
  RECEBIDO
  ENVIADO
  CONCLUIDO
  NAO_SE_APLICA
  EM_ATRASO
}

model ObrigacaoTemplate {
  id        String   @id @default(uuid())
  setorId   String
  nome      String
  descricao String?
  ativo     Boolean  @default(true)
  ordem     Int      @default(0)
  createdAt DateTime @default(now())
  // Dia do mês em que a obrigação vence (1-31). Se vazio, o sistema não
  // sabe calcular vencimento e nunca marca a instância como "Em atraso"
  // automaticamente.
  diaVencimento         Int?
  // Se true, o vencimento cai no mes SEGUINTE ao da competencia (padrao
  // pra maioria das obrigacoes fiscais/DP - ex: competencia de julho
  // vence em agosto). Se false, vence dentro do proprio mes da competencia.
  vencimentoMesSeguinte Boolean @default(false)
  setor    Setor              @relation(fields: [setorId], references: [id])
  empresas ObrigacaoEmpresa[]
  @@map("obrigacao_templates")
}

model ObrigacaoEmpresa {
  id         String   @id @default(uuid())
  empresaId  String
  templateId String
  setorId    String?
  ativa      Boolean  @default(true)
  createdAt  DateTime @default(now())
  empresa    Empresa           @relation(fields: [empresaId],  references: [id])
  template   ObrigacaoTemplate @relation(fields: [templateId], references: [id])
  instancias ObrigacaoInstancia[]
  @@unique([empresaId, templateId])
  @@map("obrigacao_empresas")
}

model ObrigacaoInstancia {
  id                 String          @id @default(uuid())
  obrigacaoEmpresaId String
  responsavelId      String?
  competencia        String
  status             StatusObrigacao @default(NAO_INICIADO)
  dataConclusao      DateTime?
  observacao         String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  obrigacaoEmpresa ObrigacaoEmpresa @relation(fields: [obrigacaoEmpresaId], references: [id])
  responsavel      Usuario?         @relation(fields: [responsavelId],      references: [id])
  @@unique([obrigacaoEmpresaId, competencia])
  @@map("obrigacao_instancias")
}

model Documento {
  id            String    @id @default(uuid())
  empresaId     String?
  pessoaId      String?
  tipoDocumento String
  nomeArquivo   String
  urlStorage    String
  tamanhoBytes  Int?
  uploadedById  String?
  dataUpload    DateTime  @default(now())
  validade      DateTime?
  observacoes   String?
  deletedAt     DateTime?
  empresa Empresa? @relation(fields: [empresaId], references: [id])
  pessoa  Pessoa?  @relation(fields: [pessoaId],  references: [id])
  @@map("documentos")
}

model ObsHistorico {
  id        String   @id @default(uuid())
  empresaId String
  usuarioId String?
  dataHora  DateTime @default(now())
  texto     String
  empresa Empresa @relation(fields: [empresaId], references: [id])
  @@map("obs_historico")
}

model Auditoria {
  id            String   @id @default(uuid())
  usuarioId     String?
  entidadeTipo  String
  entidadeId    String
  campo         String?
  valorAnterior String?
  valorNovo     String?
  acao          String
  dataHora      DateTime @default(now())
  ip            String?
  usuario Usuario? @relation(fields: [usuarioId], references: [id])
  @@map("auditoria")
}

model AgendaItem {
  id           String    @id @default(uuid())
  titulo       String
  descricao    String?
  data         DateTime  // dia do compromisso
  horaInicio   String?   // "09:00"
  horaFim      String?   // "10:30"
  diaTodo      Boolean   @default(false)
  tipo         String    @default("COMPROMISSO") // "COMPROMISSO" | "REUNIAO"
  concluido    Boolean   @default(false) // marcado quando o compromisso foi feito (fica verde na agenda)
  privado      Boolean   @default(false) // so o proprio usuario (usuarioId) ve - nem supervisor, nem Diretoria
  setorId      String?   // preenchido quando eh um compromisso do setor inteiro
  usuarioId    String?   // preenchido quando eh um compromisso de um colaborador especifico
  criadoPorId  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  setor        Setor?    @relation(fields: [setorId], references: [id])
  usuario      Usuario?  @relation("AgendaUsuario", fields: [usuarioId], references: [id])
  criadoPor    Usuario   @relation("AgendaCriador", fields: [criadoPorId], references: [id])
  @@map("agenda_itens")
}

// Lembretes pessoais mostrados na Agenda: recados pontuais do dia a dia,
// bem mais leve que um compromisso com data/hora. Texto simples com suporte
// a **negrito** (marcado na tela, renderizado como <strong> na exibição).
// Sempre pessoal: cada um só vê e mexe nos próprios lembretes.
model Lembrete {
  id         String   @id @default(uuid())
  texto      String   @db.Text
  usuarioId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
  @@map("lembretes")
}

model AcessoSistema {
  id            String   @id @default(uuid())
  empresaId     String
  setorId       String
  nomeSistema   String   // ex: "e-CAC", "eSocial", "Simples Nacional"
  link          String?  // endereco do site do sistema
  usuario       String?
  senhaCifrada  String?  // nunca em texto puro - sempre criptografada antes de salvar
  observacao    String?
  criadoPorId   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  empresa       Empresa  @relation(fields: [empresaId], references: [id])
  setor         Setor    @relation(fields: [setorId], references: [id])
  criadoPor     Usuario  @relation(fields: [criadoPorId], references: [id])
  @@map("acessos_sistema")
}

// Historico de alteracoes contratuais da empresa - sempre que o contrato
// social muda (troca de socio, capital, atividade, endereco etc.), fica
// registrado aqui: data da alteracao + o que mudou. Aparece na aba
// Societario, mais recente primeiro. Lancado manualmente, um registro por
// alteracao (nao editavel depois de criado - so exclusao, se for engano).
model AlteracaoContratual {
  id          String   @id @default(uuid())
  empresaId   String
  data        DateTime // data em que a alteracao contratual entrou em vigor
  descricao   String   // o que mudou nessa alteracao
  criadoPorId String
  createdAt   DateTime @default(now())
  empresa     Empresa  @relation(fields: [empresaId], references: [id])
  criadoPor   Usuario  @relation(fields: [criadoPorId], references: [id])
  @@map("alteracoes_contratuais")
}

// Configuracao unica (sempre um registro so, id fixo "config") com os
// dados da conta de e-mail que dispara os avisos automaticos.
model ConfiguracaoEmail {
  id                 String   @id @default("config")
  gmailUser          String?
  gmailSenhaCifrada  String?
  atualizadoPorId    String?
  updatedAt          DateTime @updatedAt
  @@map("configuracao_email")
}

// Configuracao unica (singleton, igual ConfiguracaoEmail) dos alertas e
// relatorios automaticos por e-mail - tudo editavel pela Diretoria em
// Configuracoes > Automacoes, sem precisar mexer em codigo.
model ConfiguracaoAutomacao {
  id                            String   @id @default("config")
  diasAntecedenciaVencimento    Int      @default(7)
  alertaObrigacoesAtivo         Boolean  @default(true)
  alertaCarteiraSemRespAtivo    Boolean  @default(true)
  relatorioIndividualAtivo      Boolean  @default(true)
  // 0=domingo, 1=segunda, ... 6=sabado (mesma convencao do JS Date.getUTCDay())
  relatorioIndividualDiaSemana  Int      @default(1)
  relatorioComparativoAtivo     Boolean  @default(true)
  relatorioComparativoDiaSemana Int      @default(1)
  // Lista de e-mails que recebem copia (CC) de TODO e-mail automatico do
  // sistema, separados por virgula.
  copiaEmailsFixos              String?
  atualizadoPorId                String?
  updatedAt                      DateTime @updatedAt
  @@map("configuracao_automacao")
}

model Notificacao {
  id           String   @id @default(uuid())
  usuarioId    String
  titulo       String
  mensagem     String
  lida         Boolean  @default(false)
  entidadeTipo String?
  entidadeId   String?
  dataHora     DateTime @default(now())
  usuario Usuario @relation(fields: [usuarioId], references: [id])
  @@map("notificacoes")
}

// Lista de atividades cadastradas pela Diretoria (ex: "Fechamento contabil",
// "Reuniao interna"). Usada no apontamento diario de horas de cada usuario.
model Atividade {
  id           String   @id @default(uuid())
  nome         String   @unique
  descricao    String?
  // Se true, todo registro dessa atividade precisa informar qual cliente
  // (empresa) ela foi feita para.
  exigeCliente Boolean  @default(false)
  // Se true, todo registro dessa atividade precisa informar uma
  // quantidade (ex.: 12 notas emitidas, 5 processos abertos).
  exigeQuantidade   Boolean @default(false)
  // Rotulo do que a quantidade representa (ex.: "notas", "processos").
  // Opcional - so faz sentido quando exigeQuantidade e true.
  unidadeQuantidade String?
  ativo        Boolean  @default(true)
  ordem        Int      @default(0)
  createdAt    DateTime @default(now())
  registros    RegistroAtividade[]
  @@map("atividades")
}

// Apontamento diario de horas: cada linha e um intervalo de tempo que um
// usuario passou numa atividade (opcionalmente, num cliente especifico).
model RegistroAtividade {
  id          String    @id @default(uuid())
  usuarioId   String
  atividadeId String
  empresaId   String?
  data        DateTime
  horaInicio  DateTime
  horaFim     DateTime
  quantidade  Int?
  observacao  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  usuario     Usuario   @relation(fields: [usuarioId], references: [id])
  atividade   Atividade @relation(fields: [atividadeId], references: [id])
  empresa     Empresa?  @relation(fields: [empresaId], references: [id])
  @@index([usuarioId, data])
  @@index([atividadeId])
  @@map("registros_atividade")
}
